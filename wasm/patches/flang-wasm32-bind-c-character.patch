+  /// it is harmless with most ABIs, but in WebAssembly the signature of a call
+  /// must match the callee exactly.
+  bool omitCharLen(mlir::Operation *op) {
+    if (!omitBindCCharLen)
+      return false;
+    if (fir::hasBindcAttr(op))
+      return true;
+    mlir::SymbolRefAttr callee;
+    if (auto call = mlir::dyn_cast<fir::CallOp>(op))
+      callee = call.getCalleeAttr();
+    else if (auto addr = mlir::dyn_cast<fir::AddrOfOp>(op))
+      callee = addr.getSymbol();
+    if (!callee)
+      return false;
+    auto func = getModule().lookupSymbol<mlir::func::FuncOp>(
+        callee.getRootReference());
+    return func && fir::hasBindcAttr(func.getOperation());
+  }
